---
import Layout from '../layouts/Layout.astro'
---

<Layout title="PRDS - UCC Intelligence for MCA Brokers">
  <main>
    {/* Hero Section */}
    <section class="relative bg-gradient-to-b from-blue-600 via-blue-700 to-blue-900 text-white py-20 lg:py-32">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight mb-6">
            UCC Intelligence for <span class="text-yellow-300">MCA Brokers</span>
          </h1>
          <p class="text-xl text-blue-100 mb-8 max-w-2xl">
            Turn public UCC filings into qualified leads. Real-time data from CA, TX, FL, NY — scored, enriched, and ready to close.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/signup" class="bg-yellow-300 text-blue-900 px-8 py-3 rounded-lg font-semibold text-lg hover:bg-yellow-400 transition-colors text-center">
              Start Free Trial
            </a>
            <a href="/docs" class="bg-blue-800 border border-blue-600 text-white px-8 py-3 rounded-lg font-semibold text-lg hover:bg-blue-700 transition-colors text-center">
              View Documentation
            </a>
          </div>
        </div>
      </div>
      {/* Trust indicators */}
      <div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2">
        <div class="bg-white/10 backdrop-blur-sm rounded-xl px-8 py-4 flex flex-wrap items-center justify-center gap-8 text-sm">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 20 20"><path fillRule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 12.586l-1.293-1.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clipRule="evenodd"/></svg>
            <span>4 State Collectors Live</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 20 20"><path fillRule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 12.586l-1.293-1.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clipRule="evenodd"/></svg>
            <span>Rules-Based Scoring</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 20 20"><path fillRule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 12.586l-1.293-1.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clipRule="evenodd"/></svg>
            <span>Compliance Built-In</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 20 20"><path fillRule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 12.586l-1.293-1.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clipRule="evenodd"/></svg>
            <span>API + Dashboard + CLI</span>
          </div>
        </div>
      </div>
    </section>

    {/* Features Section */}
    <section class="py-20 lg:py-32 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">Built for MCA Brokers</h2>
          <p class="text-xl text-gray-600 max-w-2xl mx-auto">
            Four state collectors. Transparent scoring. Compliance-first architecture. Everything you need to find and close deals faster.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          <FeatureCard
            icon="🏛️"
            title="4 State Collectors"
            description="CA API, TX bulk download, FL vendor feed, NY portal scraper. Each with provenance tracking and fail-closed design."
          />
          <FeatureCard
            icon="🎯"
            title="Rules-Based Scoring"
            description="Transparent 0-100 priority score from UCC recency, filing patterns, business health, and stack position. No black boxes."
          />
          <FeatureCard
            icon="🔍"
            title="Multi-Source Enrichment"
            description="Free sources (SEC, OSHA, USPTO, Census) plus key-gated vendors (D&B, Clearbit, SAM.gov). Fail-closed, never fabricated."
          />
          <FeatureCard
            icon="⚖️"
            title="Compliance First"
            description="CA SB 1235, NY CFDL disclosure calculators. TCPA/DNC suppression. Immutable audit trail. Built for regulated lending."
          />
        </div>
      </div>
    </section>

    {/* How It Works */}
    <section class="py-20 lg:py-32 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">From Filing to Funded in 4 Steps</h2>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          <StepCard number="1" title="Collect" description="Automated daily ingestion from CA, TX, FL, NY SOS portals. Provenance tracked." />
          <StepCard number="2" title="Enrich" description="Free + vendor data layered on. Business health, growth signals, compliance flags." />
          <StepCard number="3" title="Score" description="Transparent rules-based 0-100 priority score. Health grade. Stack position." />
          <StepCard number="4" title="Deliver" description="Dashboard, API, CLI, or broker share links. Signed URLs with expiry and audit." />
        </div>
      </div>
    </section>

    {/* Compliance */}
    <section class="py-20 lg:py-32 bg-blue-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-6">Compliance Isn't an Afterthought</h2>
          <p class="text-xl text-gray-600 mb-12">
            Built-in disclosure calculators (CA SB 1235, NY CFDL), TCPA/DNC suppression, immutable audit trail.
            Every action logged. Every decision auditable.
          </p>
          <div class="grid md:grid-cols-3 gap-8">
            <ComplianceItem title="CA SB 1235" description="Disclosure calculator for California commercial financing" />
            <ComplianceItem title="NY CFDL" description="New York Commercial Finance Disclosure Law calculator" />
            <ComplianceItem title="TCPA/DNC" description="Federal and state do-not-call suppression built-in" />
            <ComplianceItem title="Audit Trail" description="Immutable hash-chained log of every action" />
            <ComplianceItem title="Data Minimization" description="Only collect what's needed. Automatic retention policies." />
            <ComplianceItem title="Broker Isolation" description="Tenant-bound data. Zero cross-contamination." />
          </div>
        </div>
      </div>
    </section>

    {/* CTA */}
    <section class="py-20 lg:py-32 bg-gray-900">
      <div class="max-w-3xl mx-auto text-center px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">Ready to Close More Deals?</h2>
        <p class="text-xl text-gray-300 mb-10 max-w-2xl mx-auto">
          Join brokers using PRDS to find qualified MCA prospects faster. Free tier available. No credit card required.
        </p>
        <a href="/signup" class="inline-block bg-yellow-300 text-gray-900 px-10 py-4 rounded-lg font-semibold text-lg hover:bg-yellow-400 transition-colors">
          Start Free Trial
        </a>
      </div>
    </section>
  </main>
</Layout>

<script>
  // Client-side only components
  function FeatureCard({icon, title, description}) {
    return (
      <div class="bg-white p-8 rounded-xl border border-gray-100 hover:border-blue-200 hover:shadow-lg transition-all duration-300 h-full">
        <div class="text-4xl mb-4">{icon}</div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">{title}</h3>
        <p class="text-gray-600">{description}</p>
      </div>
    );
  }

  function StepCard({number, title, description}) {
    return (
      <div class="relative pl-12 pb-8 border-l-2 border-blue-200 last:border-0">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-xl">
          {number}
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">{title}</h3>
        <p class="text-gray-600">{description}</p>
      </div>
    );
  }

  function ComplianceItem({title, description}) {
    return (
      <div class="bg-white p-6 rounded-xl border border-gray-100">
        <h3 class="font-semibold text-gray-900 mb-2">{title}</h3>
        <p class="text-gray-600">{description}</p>
      </div>
    );
  }
</script>